rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ═══════════════════════════════════════════════════════════════
    // FUNCIONES AUXILIARES
    // ═══════════════════════════════════════════════════════════════
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && 
             request.auth.token.super_admin == true;
    }
    
    // NOTA: super_admin es SOLO para administración de la plataforma
    // NO es para operaciones diarias (crear cierres, liquidar, etc.)
    
    // ───────────────────────────────────────────────────────────────
    // SOLUCIÓN TEMPORAL: Permitir a usuarios autenticados
    // TODO: Implementar Custom Claims para roles de restaurante
    // ───────────────────────────────────────────────────────────────
    
    // Por ahora, cualquier usuario autenticado puede acceder
    // Esto es TEMPORAL hasta implementar Custom Claims
    function isClosureEditor(restaurantId) {
      return isAuthenticated();
    }
    
    function isOwner(restaurantId) {
      return isAuthenticated();
    }
    
    function isRestaurantViewer(restaurantId) {
      return isAuthenticated();
    }
    
    // Puede ver TODO del restaurante (closure_editor u owner)
    function canViewAll(restaurantId) {
      return isAuthenticated();
    }
    
    // Tiene algún rol en el restaurante
    function hasAnyRestaurantRole(restaurantId) {
      return isAuthenticated();
    }
    
    // ═══════════════════════════════════════════════════════════════
    // COLECCIÓN: /users
    // Documentos de usuarios con roles y permisos
    // ═══════════════════════════════════════════════════════════════
    match /users/{userId} {
      // LEER: Solo el propio usuario o super_admin
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        isSuperAdmin()
      );
      
      // CREAR: Solo el propio usuario durante registro
      allow create: if isAuthenticated() && 
        request.auth.uid == userId &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email;
      
      // ACTUALIZAR: El propio usuario (campos limitados) o super_admin
      // NOTA: El usuario puede actualizar restaurantRoles y primaryRestaurant (para borrar restaurante)
      // NOTA: El usuario NO puede modificar siteRoles, isActive, uid, email
      allow update: if isAuthenticated() && (
        (request.auth.uid == userId && 
         !request.resource.data.diff(resource.data).affectedKeys()
           .hasAny(['siteRoles', 'isActive', 'uid', 'email'])) ||
        isSuperAdmin()
      );
      
      // ELIMINAR: El propio usuario o super_admin
      // NOTA: Permite al usuario borrar su cuenta cuando borra su restaurante
      allow delete: if isAuthenticated() && (
        request.auth.uid == userId ||
        isSuperAdmin()
      );
    }
    
    // ═══════════════════════════════════════════════════════════════
    // COLECCIÓN: /restaurants
    // Configuración de restaurantes
    // ═══════════════════════════════════════════════════════════════
    match /restaurants/{restaurantId} {
      // LEER: Miembros del restaurante (closure_editor, owner, restaurant_viewer)
      // NOTA: Todos pueden ver porque owner es testigo legal y restaurant_viewer ve liquidaciones
      // NOTA: También permite leer si restaurantId == uid (para permitir borrado)
      allow read: if hasAnyRestaurantRole(restaurantId) || 
                     request.auth.uid == restaurantId ||
                     isSuperAdmin();
      
      // CREAR: Usuario autenticado durante registro
      allow create: if isAuthenticated() && 
        request.resource.data.ownerId == request.auth.uid;
      
      // ACTUALIZAR: Solo closure_editor
      // NOTA: owner NO puede editar (Ley 20.549)
      // NOTA: restaurant_viewer NO puede editar
      allow update: if isClosureEditor(restaurantId) || isSuperAdmin();
      
      // ELIMINAR: El propietario o super_admin
      // NOTA: Permite al usuario borrar su propio restaurante para cambiarse
      // NOTA: Como restaurantId == uid, verificamos directamente
      allow delete: if isAuthenticated() && (
        request.auth.uid == restaurantId ||
        isSuperAdmin()
      );
    }
    
    // ═══════════════════════════════════════════════════════════════
    // SUBCOLECCIÓN: /restaurants/{restaurantId}/registros_diarios
    // Cierres diarios de propinas
    // ═══════════════════════════════════════════════════════════════
    match /restaurants/{restaurantId}/registros_diarios/{closureId} {
      // LEER: Cualquier usuario autenticado
      // NOTA: Validación de roles se hace en el código de la aplicación
      allow read: if isAuthenticated();
      
      // CREAR: Solo closure_editor
      // NOTA: owner NO puede crear (Ley 20.549)
      // NOTA: restaurant_viewer NO puede crear
      allow create: if isClosureEditor(restaurantId);
      
      // ACTUALIZAR: Solo closure_editor
      // NOTA: owner NO puede editar (Ley 20.549)
      // NOTA: restaurant_viewer NO puede editar
      allow update: if isClosureEditor(restaurantId);
      
      // ELIMINAR: Solo closure_editor
      // NOTA: closure_editor puede eliminar cierres
      allow delete: if isClosureEditor(restaurantId);
      
      // SUBCOLECCIÓN: ajustes (incrementos/descuentos por cierre)
      match /ajustes/{adjustmentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if isAuthenticated();
      }
    }
    
    // ═══════════════════════════════════════════════════════════════
    // COLECCIÓN: /staff
    // Personal del restaurante (garzones, cocineros)
    // NOTA: Staff NO son usuarios del sistema, son documentos de empleados
    // ═══════════════════════════════════════════════════════════════
    match /staff/{staffId} {
      // LEER: Miembros del restaurante
      // NOTA: Validación requiere campo restaurantId en el documento
      allow read: if isAuthenticated() && (
        hasAnyRestaurantRole(resource.data.restaurantId) ||
        isSuperAdmin()
      );
      
      // CREAR: Solo closure_editor del restaurante
      allow create: if isAuthenticated() && (
        isClosureEditor(request.resource.data.restaurantId) ||
        isSuperAdmin()
      );
      
      // ACTUALIZAR: Solo closure_editor (para marcar isActive: false o editar)
      // NOTA: closure_editor puede desactivar o eliminar miembros del staff
      allow update: if isAuthenticated() && (
        isClosureEditor(resource.data.restaurantId) ||
        isSuperAdmin()
      );
      
      // ELIMINAR: Solo closure_editor
      // NOTA: closure_editor puede eliminar miembros del staff
      allow delete: if isAuthenticated() && (
        isClosureEditor(resource.data.restaurantId) ||
        isSuperAdmin()
      );
    }
    
    // ═══════════════════════════════════════════════════════════════
    // COLECCIÓN: /liquidaciones
    // Liquidaciones de períodos de propinas
    // ═══════════════════════════════════════════════════════════════
    match /liquidaciones/{liquidacionId} {
      // LEER: Todos los miembros del restaurante
      // NOTA: closure_editor y owner ven TODO
      // NOTA: restaurant_viewer solo ve liquidaciones (es lo único que puede ver)
      allow read: if isAuthenticated() && (
        hasAnyRestaurantRole(resource.data.restaurantId) ||
        isSuperAdmin()
      );
      
      // CREAR: Solo closure_editor
      // NOTA: owner NO puede crear (Ley 20.549)
      // NOTA: restaurant_viewer NO puede crear (solo ver)
      allow create: if isAuthenticated() && (
        isClosureEditor(request.resource.data.restaurantId) ||
        isSuperAdmin()
      );
      
      // ACTUALIZAR/EDITAR: Solo closure_editor
      // NOTA: owner NO puede editar
      // NOTA: restaurant_viewer NO puede editar
      allow update: if isAuthenticated() && (
        isClosureEditor(resource.data.restaurantId) ||
        isSuperAdmin()
      );
      
      // ELIMINAR: Solo closure_editor
      // NOTA: closure_editor puede eliminar liquidaciones
      allow delete: if isAuthenticated() && (
        isClosureEditor(resource.data.restaurantId) ||
        isSuperAdmin()
      );
    }
    
    // ═══════════════════════════════════════════════════════════════
    // COLECCIÓN: /invitations
    // Invitaciones para unirse a restaurantes
    // ═══════════════════════════════════════════════════════════════
    match /invitations/{invitationId} {
      // LEER: El invitador, el invitado o super_admin
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.invitedByUid ||
        request.auth.token.email == resource.data.invitedEmail ||
        isSuperAdmin()
      );
      
      // CREAR: Solo closure_editor del restaurante
      allow create: if isAuthenticated() && (
        isClosureEditor(request.resource.data.restaurantId) ||
        isSuperAdmin()
      );
      
      // ACTUALIZAR: El invitado (para aceptar/rechazar) o el invitador
      allow update: if isAuthenticated() && (
        request.auth.token.email == resource.data.invitedEmail ||
        request.auth.uid == resource.data.invitedByUid ||
        isSuperAdmin()
      );
      
      // ELIMINAR: El invitador o super_admin
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.invitedByUid ||
        isSuperAdmin()
      );
    }
    
    // ═══════════════════════════════════════════════════════════════
    // BLOQUEO GENERAL
    // Todo lo demás está bloqueado por defecto
    // ═══════════════════════════════════════════════════════════════
  }
}
